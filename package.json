{
  "name": "babylon-museum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "version-content": "node scripts/version-content.mjs",
    "predev": "npm run version-content",
    "dev": "vite",
    "server": "node server/index.mjs",
    "dev:admin": "npm run server & npm run dev",
    "prebuild": "npm run version-content",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "npm run version-content",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "optimize-model": "gltf-transform optimize --texture-compress ktx2"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0",
    "express": "^5.2.1",
    "image-size": "^2.0.4",
    "multer": "^2.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
